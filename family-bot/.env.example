# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Публичный HTTPS-адрес, на котором крутится это приложение.
# Именно его Telegram открывает как Mini App и по нему же работают ссылки-шеринги.
# Для локальной разработки: cloudflared tunnel --url http://localhost:8080
PUBLIC_URL=https://example.com

# База. По умолчанию SQLite в файле рядом с проектом.
# Postgres: postgresql+asyncpg://user:pass@localhost:5432/family
DATABASE_URL=sqlite+aiosqlite:///./family.db

# Валюта по умолчанию
DEFAULT_CURRENCY=UAH

# polling — бот сам ходит за апдейтами (проще, работает без белого IP)
# webhook — Telegram стучится на PUBLIC_URL/telegram/webhook
BOT_MODE=polling
WEBHOOK_SECRET=change-me

HOST=0.0.0.0
PORT=8080

# Только для локальной отладки веб-приложения без Telegram.
# Если задано — API принимает запросы без подписи initData от этого tg_id.
# На проде оставить пустым!
DEV_TG_ID=

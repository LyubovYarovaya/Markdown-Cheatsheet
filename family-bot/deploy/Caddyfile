# Сертификат Let's Encrypt Caddy получает и продлевает сам —
# нужно лишь, чтобы домен смотрел на этот сервер и были открыты порты 80 и 443.

{$DOMAIN} {
	encode gzip
	reverse_proxy app:8080

	# Публичные страницы списков не должны попадать в поисковики.
	header /s/* X-Robots-Tag "noindex, nofollow"
}
